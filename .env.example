# Production uses Authelia. --local development listens only on loopback.
NODE_ENV=production
HOST=0.0.0.0
PORT=4174
PUBLIC_ORIGIN=https://dashboard.your-domain.example
DOMAIN=your-domain.example
TIMEZONE=Asia/Kolkata
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
DATA_DIR=./data
# The actual immediate Traefik container IP, preferably /32. Never trust all IPs.
AUTH_TRUSTED_PROXY_CIDRS=
AUTH_HOUSEHOLD_GROUP=purrbrews_household
AUTH_ADMIN_GROUP=purrbrews_admins
AUTH_WALL_GROUP=purrbrews_wall_display
HA_ENTITIES_FILE=./config/home.json
SERVICES_FILE=./config/services.json
# Direct backend address, e.g. http://192.168.0.13:8123
HA_URL=
HA_TOKEN=
# Direct Actual backend URL, e.g. http://actualbudget:5006
ACTUAL_SERVER_URL=
ACTUAL_SYNC_ID=
# For existing OpenID authentication use a current Actual session token.
# Configure token OR password, never both. Keep Authelia/OpenID enabled.
ACTUAL_SESSION_TOKEN=
ACTUAL_PASSWORD=
ACTUAL_ENCRYPTION_PASSWORD=
BUDGET_CURRENCY=INR
# Direct backend route, not the interactive Authelia-protected Gatus UI.
GATUS_URL=
GATUS_AUTHORIZATION=
# Optional JSON map: node name -> exact Gatus key. Otherwise exact name matching.
GATUS_FLEET_KEYS={}
