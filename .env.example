# Copy to .env and fill in. Never commit .env. Values below are placeholders.

# --- Address and access -------------------------------------------------
# The dashboard's public hostname. Used for the Traefik router and for the
# browser origin check (https://<PUBLIC_HOSTNAME>).
PUBLIC_HOSTNAME=dashboard.your-domain.example
# Base domain for service shortcuts that use "host" in config/services.json.
DOMAIN=your-domain.example
# Immediate reverse-proxy container IP, preferably /32. Never trust all IPs.
AUTH_TRUSTED_PROXY_CIDRS=
AUTH_HOUSEHOLD_GROUP=purrbrews_household
AUTH_ADMIN_GROUP=purrbrews_admins
AUTH_WALL_GROUP=purrbrews_wall_display

# --- Compose / Traefik wiring (defaults shown) -------------------------
# COMPOSE_PROJECT_NAME=purrbrews-cafe
# CAFE_IMAGE=purrbrews-dashboard:local
# PROXY_NETWORK=proxy
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_AUTH_MIDDLEWARE=authelia@file

# --- Display ------------------------------------------------------------
# IANA time zone and BCP 47 locale (number grouping, dates). Defaults: UTC, en.
TIMEZONE=UTC
LOCALE=en

# --- Secrets ------------------------------------------------------------
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Back it up with the data volume; losing it makes saved mailboxes unreadable.
APP_ENCRYPTION_KEY=

# --- Home Assistant (optional) -----------------------------------------
# Backend address reachable from the container, e.g. http://homeassistant.lan:8123
HA_URL=
HA_TOKEN=

# --- Actual Budget (optional) ------------------------------------------
# Backend address reachable from the container, e.g. http://actual-server:5006
ACTUAL_SERVER_URL=
ACTUAL_SYNC_ID=
# Session token OR password, never both.
ACTUAL_SESSION_TOKEN=
ACTUAL_PASSWORD=
ACTUAL_ENCRYPTION_PASSWORD=
# Required when Actual is configured, e.g. EUR, INR, USD.
BUDGET_CURRENCY=

# --- Personal mail over IMAP (optional) --------------------------------
# Leave MAIL_IMAP_HOST empty to hide mail. TLS is always required.
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
# Shown in the UI, e.g. "Fastmail" -> "Your Fastmail inbox". Optional.
MAIL_PROVIDER_NAME=

# --- Gatus fleet status (optional) -------------------------------------
# Backend route, not an interactive SSO-protected UI.
GATUS_URL=
GATUS_AUTHORIZATION=
# Comma-separated node names to show, in order. Empty shows every endpoint.
FLEET_NODES=
# Optional JSON map: node name -> exact Gatus key, e.g. {"node-a":"core_node-a"}
GATUS_FLEET_KEYS={}
